---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import WhyIBuilt from "../components/WhyIBuilt.astro";
import { getCollection } from "astro:content";
import { SOCIAL } from "../config";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hi there 👋</div>
    <h1 class="text-5xl font-bold">I'm Francisco Avalos Jr.</h1>
    <div class="text-3xl py-3 font-bold">Sr. Data Scientist / Machine Learning</div>
    <div class="py-2 text-lg space-y-4">
      <p class="text-xl font-bold">I turn messy real-world data into models that people actually use.</p>
      <p>
        I'm a data scientist with 10+ years of experience and an M.S. in Applied Statistics &amp; Data Science from
        UCLA. My work is about helping teams act sooner and waste less. A few examples:
      </p>
      <ul class="list-disc pl-6 space-y-3">
        <li>
          <strong>Predicting failures before they happen.</strong> I built a model that predicts which EV charger parts
          are about to fail (~90% accuracy, 85–90% precision and recall). The service team used it to order parts ahead
          of breakdowns, which cut station downtime by about 5% in the test market.
        </li>
        <li>
          <strong>Making sense of free text with AI.</strong> I built an LLM pipeline (RAG with vector embeddings and
          Llama 3 70B in Snowflake Cortex). It automatically matched about 80% of free-text hardware issue reports to
          standard error codes.
        </li>
        <li>
          <strong>Catching problems early and keeping customers.</strong> I built a statistical anomaly-detection system
          that saves about $10K per incident, and a retention analysis that helped lift re-engagement from 20% to 50%.
        </li>
      </ul>
      <p>
        On my own time, I build and deploy complete ML apps, like the
        <a class="link" href="#featured-projects">fantasy sports forecasting dashboards below</a>. They use time-series
        models (ARIMA, LSTM), survival analysis, count models and a grounded LLM assistant.
      </p>
      <p>
        I also lead pro-bono Bayesian and causal-inference projects for nonprofits through Statistics Without Borders.
        One recent delivery is
        <a class="link" href="https://zero-portugal.vercel.app/" target="_blank" rel="noopener">Aerovoos AHD</a>, a
        daily-updated dashboard for the Portuguese environmental nonprofit ZERO. It tracks night flights at Lisbon's
        airport and flags the nights and weeks that break the legal limits.
      </p>
      <p>
        A traveler, an avid reader and a lifelong sports fan. I'd rather win my fantasy league with a model than a
        guess.
      </p>
      <p class="text-base">
        <strong>Core skills:</strong> Python, SQL, R · Machine learning, time series, survival analysis, Bayesian methods,
        causal inference, experimental design · LLMs, RAG, embeddings · Snowflake (Snowpark, Cortex), AWS · Tableau,
        Power BI
      </p>
    </div>
    <div class="mt-8 flex flex-wrap gap-4">
      <a class="btn" href={SOCIAL.linkedin} target="_blank" rel="noopener">Let's connect!</a>
      <a class="btn btn-outline" href="/projects/">View my projects</a>
    </div>
  </div>

  <h2 id="featured-projects" class="text-3xl w-full font-bold mb-4 scroll-mt-20">Featured projects {"</>"}</h2>
  <WhyIBuilt />
  <div class="flex flex-col gap-6">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</BaseLayout>
